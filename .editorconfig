# EditorConfig: 统一多编辑器基础行为规范
# 官方规范参考: https://editorconfig.org

root = true

# 1. 全局默认规范（适用于所有文件）
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# 2. Markdown 文档特殊处理
[*.md]
# 禁止清除行尾空格（Markdown 中末尾 2 个空格代表换行 <br>）
trim_trailing_whitespace = false
# 文档放宽单行字符限制
max_line_length = off

# 3. Windows 批处理脚本（与 .gitattributes 保持一致）
[*.{bat,cmd}]
end_of_line = crlf

# 4. Makefile 必须使用 Tab 缩进（兼容构建工具标准）
[Makefile]
indent_style = tab
