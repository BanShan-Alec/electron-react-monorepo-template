# ==============================================================================
# 运行时语义与模式控制 (由 package.json 脚本自动注入，通常无需手动修改)
# 可选值: development (本地开发调试) | production (生产预览行为) | test (自动化测试)
# ==============================================================================
MODE=development

# ==============================================================================
# GitHub Releases 自动更新配置 (生产打包与 OTA 在线更新事实源)
# 本项目为通用模板，请务必在发版前配置为您自己的 GitHub 组织/用户名与仓库名
# ==============================================================================
GITHUB_OWNER=BanShan-Alec
GITHUB_REPO=electron-react-monorepo-template
DISTRIBUTION_CHANNEL=latest

# ==============================================================================
# Sentry 错误追踪与监控配置 (选填，仅在生产打包且配置有效 DSN 时激活)
# ==============================================================================
# SENTRY_DSN 仅用于运行时错误采集上报（生产模式）
SENTRY_DSN=

# SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN 供构建期 SourceMap 上传插件使用
# 若不上传 SourceMap 到 Sentry，保留留空即可（构建时将自动跳过 Sentry 插件上传）
SENTRY_ORG=o4512213407105024
SENTRY_PROJECT=4512220144730112
SENTRY_AUTH_TOKEN=

# ==============================================================================
# 业务 API 网关与系统标识
# ==============================================================================
API_BASE_URL=https://api.example.com
SYSTEM_CODE=ELECTRON_APP

# ==============================================================================
# CI 门禁 / 构建质量防护阈值
# ==============================================================================
# 主进程 asar 打包体积防劣化阈值 (单位: MB，默认 10)
MAX_ASAR_SIZE_MB=10

# 默认主干分支名称 (默认 main)
DEFAULT_BRANCH=main

# ==============================================================================
# 本地 / E2E 演示与基准测试控制 (选填，供测试人员本地指定)
# ==============================================================================
# DEMO_MODE: 开启时慢速单步执行 OTA 测试用例 (单位: 布尔值 0 | 1)
DEMO_MODE=0
# BENCHMARK: 开启时运行 Vitest 基准性能测试 (单位: 布尔值 true | false)
BENCHMARK=false
