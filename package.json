{
  "name": "electron-react-monorepo-template",
  "productName": "Electron React Template",
  "description": "Type-safe Electron monorepo template powered by Vite, React and ContextBridge IPC",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "main": "packages/main/dist/index.cjs",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "^10.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:app": "node scripts/build.ts",
    "build:dir": "node scripts/build.ts --dir",
    "build:win": "node scripts/build.ts --win",
    "build:mac": "node scripts/build.ts --mac",
    "build:linux": "node scripts/build.ts --linux",
    "start": "node scripts/dev.ts",
    "typecheck": "tsc -p scripts/tsconfig.json --noEmit && pnpm -r run typecheck",
    "lint": "biome check --config-path=.config .",
    "lint:fix": "biome check --write --config-path=.config .",
    "format": "biome format --write --config-path=.config .",
    "changelog": "changelogen",
    "release": "changelogen --release",
    "release:patch": "changelogen --release --patch",
    "release:minor": "changelogen --release --minor",
    "release:major": "changelogen --release --major",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --config-path=.config --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@app/tsconfig": "workspace:*",
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "catalog:",
    "changelogen": "^0.6.2",
    "electron": "41.0.3",
    "electron-builder": "26.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {
    "@app/main": "workspace:*",
    "@app/preload": "workspace:*",
    "@app/renderer": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  },
  "allowScripts": {
    "electron@41.0.3": true,
    "electron-winstaller@5.4.0": true,
    "globals": true
  }
}
